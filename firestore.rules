rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && (request.auth.token.email.matches('(?i)^luxaidevs@gmail\\.com$') || request.auth.token.email == "luxaidevs@gmail.com")
        && request.auth.token.email_verified == true;
    }

    function isAppointedAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.status == "active";
    }

    function isAdminOrSuperAdmin() {
      return isSuperAdmin() || isAppointedAdmin();
    }

    function isVerificationAdmin() {
      return isSuperAdmin() || (
        isAppointedAdmin() && (
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.roles.hasAny(['verification_manager']) ||
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.permissions.hasAny(['verification:approve', 'verification:reject', '*'])
        )
      );
    }

    function isUsernameAdmin() {
      return isSuperAdmin() || (
        isAppointedAdmin() && (
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.roles.hasAny(['username_manager']) ||
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.permissions.hasAny(['usernames:view', 'usernames:approve', 'usernames:reject', 'usernames:reserve', 'usernames:assign', '*'])
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admins management: only super admin can create/edit/delete admins
    // Appointed admin can read their own record to verify permissions
    match /admins/{adminEmail} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.token.email != null && request.auth.token.email.lower() == adminEmail.lower());
      allow create, update, delete: if isSuperAdmin();
    }

    // Users: owner can read/write their own info, admins can read all users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrSuperAdmin();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // Private locations: exact coordinates are strictly private to the user
    match /user_locations/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // Profiles: users can read profiles for the swipe deck, only owner can edit their own
    // Normal users CANNOT self-promote to verified = true
    match /tinder_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if isSuperAdmin() || isVerificationAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'isVerified', 'verificationApprovedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // Swipes: users record their likes and nopes
    match /tinder_swipes/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();

      match /likes/{targetId} {
        allow create, update, delete: if isOwner(userId) || isSuperAdmin();
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == targetId) || isSuperAdmin();
      }
    }

    // Favorites: users can only manage their own saved profiles
    match /tinder_favorites/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();

      match /items/{targetId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Super Likes: sender can create, recipient/sender/admin can read
    match /tinder_super_likes/{superLikeId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUid;
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid || isAdminOrSuperAdmin());
      allow update, delete: if (isAuthenticated() && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid)) || isAdminOrSuperAdmin();
    }

    // Blocks: users manage their own blocklist
    match /tinder_blocks/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();

      match /blocked/{targetId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == targetId) || isSuperAdmin();
        allow write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // Matches and realtime chat messages
    match /tinder_matches/{matchId} {
      allow read: if (isAuthenticated() && request.auth.uid in resource.data.users) || isAdminOrSuperAdmin();
      allow create: if isAuthenticated() || isAdminOrSuperAdmin();
      allow update: if (isAuthenticated() && request.auth.uid in resource.data.users) || isAdminOrSuperAdmin();
      allow delete: if (isAuthenticated() && request.auth.uid in resource.data.users) || isSuperAdmin();

      match /messages/{messageId} {
        allow read, create: if isAuthenticated() || isAdminOrSuperAdmin();
        allow update: if isAuthenticated() || isAdminOrSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // Reports: normal users can submit reports, admins can read/moderate
    match /reports/{reportId} {
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.reporterUid || request.auth.uid == request.resource.data.reporterId);
      allow read, update: if isAdminOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Notifications: recipient can read/manage their own notifications; authenticated users can create notifications for recipient
    match /tinder_notifications/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();

      match /items/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isSuperAdmin();
        allow create: if isAuthenticated();
      }
    }

    // Dating Preferences: users can read and write only their own preferences
    match /tinder_preferences/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // Verification Requests:
    // - User can create and read only their own request
    // - Verification Admin or Super Admin can read and update (approve/reject)
    match /verificationRequests/{requestId} {
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.status == "pending";
      allow read: if (isAuthenticated() && request.auth.uid == resource.data.uid) || isVerificationAdmin();
      allow update: if isVerificationAdmin();
      allow delete: if isSuperAdmin();
    }

    // Stage 12: Unique @username System & Registry
    // - Authenticated users can read usernames to search, resolve, or verify uniqueness
    // - Normal users can only register their own UID and cannot hijack reserved names
    // - Super Admin & Username Managers have full moderation authority
    match /usernames/{normalizedUsername} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && (request.auth.uid == request.resource.data.uid || isUsernameAdmin())
        && (!exists(/databases/$(database)/documents/reservedUsernames/$(normalizedUsername)) || isUsernameAdmin());
      allow update: if isUsernameAdmin() || (
        isAuthenticated() && request.auth.uid == resource.data.uid && request.auth.uid == request.resource.data.uid
      );
      allow delete: if isUsernameAdmin() || (
        isAuthenticated() && request.auth.uid == resource.data.uid
      );
    }

    // Reserved usernames: platform, brand, official, system names
    // Only Super Admin and Username Managers can create, update, or remove
    match /reservedUsernames/{normalizedUsername} {
      allow read: if isAuthenticated();
      allow write: if isUsernameAdmin();
    }

    // Username requests:
    // - User can request custom/reserved/brand username
    // - Only owner can create (with pending status) and cancel
    // - Only Username Admin / Super Admin can approve or reject
    match /usernameRequests/{requestId} {
      allow read: if isUsernameAdmin() || (isAuthenticated() && request.auth.uid == resource.data.uid);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.status == "pending";
      allow update: if isUsernameAdmin() || (
        isAuthenticated() && request.auth.uid == resource.data.uid && request.resource.data.status == "cancelled"
      );
      allow delete: if isSuperAdmin();
    }

    // Username history for anti-hijacking and cooldown
    match /usernameHistory/{normalizedUsername} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() || isUsernameAdmin();
    }

    // Moderation flags created by safety automation
    match /moderationFlags/{flagId} {
      allow read, update: if isAdminOrSuperAdmin();
      allow create: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // Admin audit logs: admins can read and log actions, only super admin can delete
    match /admin_logs/{logId} {
      allow read, create: if isAdminOrSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // Catch-all administrative fallback
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
